api.mezamir.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle_path /o/tehnodor-sk/* {
		reverse_proxy org-tehnodor-sk-api:8000
	}
	import /etc/caddy/organizations/*.caddy
	# Unknown codes must never fall through to the default organization's API.
	handle /o/* {
		respond "Organization not found" 404
	}
	handle {
		reverse_proxy org-tehnodor-sk-api:8000
	}
}
